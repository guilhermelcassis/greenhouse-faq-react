{
  "$schema": "https://cursor.sh/rules-schema.json",
  "rules": {
    "general": {
      "exclude": [
        "node_modules/**",
        ".next/**",
        "out/**",
        "*.local*"
      ],
      "codingStandards": {
        "preferFunctionalComponents": true,
        "typescriptPreferred": true,
        "inlineStyles": "avoid"
      }
    },
    "typescript": {
      "description": "TypeScript specific rules",
      "requirePatterns": [
        // Enforce interfaces for data structures
        "interface [A-Z]",
        "type [A-Z]",
        // Enforce React component types
        ": React.ReactNode",
        ": React.FC<",
        // Enforce proper TypeScript types
        ": string",
        ": number",
        ": boolean",
        ": object"
      ],
      "denyPatterns": [
        // Block the use of `any` type
        ": any",
        "as any"
      ],
      "suggestions": [
        {
          "pattern": ": any",
          "suggestion": "Please use a specific type instead of `any`. For example, use `: string`, `: number`, or define an interface."
        }
      ]
    },
    "firebase": {
      "description": "Enforce Firebase usage for auth and database",
      "allowPatterns": [
        "import.*firebase/app",
        "import.*firebase/auth",
        "import.*firebase/firestore",
        "getAuth",
        "signInWithEmailAndPassword",
        "createUserWithEmailAndPassword",
        "signOut",
        "onAuthStateChanged",
        "doc.*firestore",
        "collection.*firestore",
        "getDoc",
        "setDoc",
        "initializeApp"
      ],
      "denyPatterns": [
        "next-auth/react",
        "next-auth/client",
        "next-auth/providers",
        "useSession",
        "getSession",
        "signIn.*github",
        "signIn.*google.*next-auth",
        "authOptions.*next-auth"
      ]
    },
    "nextjs": {
      "description": "Next.js specific rules",
      "allowPatterns": [
        "use client",
        "use server",
        "generateStaticParams",
        "dynamicParams",
        "export const dynamic",
        "metadata exports"
      ],
      "denyPatterns": [
        "getServerSideProps.*auth.*next-auth",
        "getStaticProps.*auth.*next-auth"
      ]
    }
  },
  "patterns": {
    "deny": [
      {
        "pattern": "next-auth",
        "message": "This project uses Firebase for authentication. Avoid Next Auth-related imports."
      },
      {
        "pattern": "useSession",
        "message": "Please use Firebase auth state listeners instead of Next Auth sessions."
      },
      {
        "pattern": ": any",
        "message": "Avoid using `any` type. Use a specific type or define an interface."
      }
    ]
  }
}